# 実機から採った受信バイトは、1 バイトも変えずに持つ。
#
# core.autocrlf が有効な環境では、git が中身を見てテキストと判断した
# ファイルの CRLF を LF へ正規化する。cisco_ios_vt100.bin は制御文字が
# CR/LF/BS しか無く平文に近いため、これに巻き込まれて CR が 147 個
# すべて剥がされていた。作業ツリーでは元へ戻るので気づけず、
# Linux での clone や、リリースに添付される Source code アーカイブ
# （GPL の対応ソース）だけが壊れた状態で配られていた。
tests/fixtures/*.bin -text

# バッチファイルは CRLF で格納する。
#
# 上と同じ機構で、逆向きに壊れていた。作業ツリーが CRLF なのは
# core.autocrlf=true のおかげで、格納されているバイト列は LF だった。
# cmd.exe は LF だけのバッチファイルを 1 行も正しく実行できない
# （行の途中や日本語コメントの断片がコマンドとして実行される）。
# autocrlf に守られない経路 — GitHub が各リリースへ自動添付する
# Source code アーカイブ（GPL の対応ソース）と、
# core.autocrlf=false / input での clone — だけが壊れた updater.bat を
# 受け取り、そこからビルドした NetBelt は自動更新が一切効かなかった。
*.bat text eol=crlf

# シェルスクリプトは LF で格納し、LF で取り出す。
#
# .claude/hooks/session-start.sh は Claude Code が起動のたびに bash で
# 実行する。core.autocrlf=true の Windows で取り出すと CRLF になり、bash は
# 行末の CR をコマンドの一部として読む（実測: set -euo pipefail の行で
# invalid option name になって止まる。シバンで直接起動すると、その前に
# "bash\r" が見つからずに止まる）。
# クラウドでだけ働くスクリプトだが、手元の起動でもいったん実行される。
*.sh text eol=lf
